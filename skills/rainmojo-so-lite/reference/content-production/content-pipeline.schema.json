{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rainmojo.local/schemas/content-pipeline.schema.json",
  "title": "RAINMOJO SO content-pipeline.json",
  "type": "object",
  "required": [
    "version",
    "config_policy",
    "engine",
    "site",
    "content",
    "links",
    "provenance",
    "seo",
    "images",
    "wordpress",
    "quality_gates"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "config_policy": {
      "type": "object",
      "required": [
        "profile",
        "require_client_file"
      ],
      "properties": {
        "profile": {
          "enum": [
            "production",
            "demo",
            "test"
          ]
        },
        "require_client_file": {
          "const": true
        },
        "explicit_defaults_profiles": {
          "type": "array",
          "items": {
            "enum": [
              "demo",
              "test"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "engine": {
      "type": "object",
      "required": [
        "mode",
        "source_of_truth",
        "capabilities",
        "adapter"
      ],
      "properties": {
        "mode": {
          "enum": [
            "generic",
            "client_native"
          ]
        },
        "source_of_truth": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "object",
          "required": [
            "scope",
            "content",
            "images",
            "wordpress_draft",
            "content_review",
            "image_source_review",
            "image_visual_review",
            "verify_only",
            "draft_only"
          ],
          "properties": {
            "scope": {
              "enum": [
                "end_to_end",
                "image_only",
                "partial"
              ]
            },
            "content": {
              "type": "boolean"
            },
            "images": {
              "type": "boolean"
            },
            "wordpress_draft": {
              "type": "boolean"
            },
            "content_review": {
              "type": "boolean"
            },
            "image_source_review": {
              "type": "boolean"
            },
            "image_visual_review": {
              "type": "boolean"
            },
            "verify_only": {
              "type": "boolean"
            },
            "draft_only": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "adapter": {
          "type": "object",
          "required": [
            "allowed_commands",
            "operations"
          ],
          "properties": {
            "allowed_commands": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "operations": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "generic"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "source_of_truth": {
                "const": "content/production"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "client_native"
              }
            }
          },
          "then": {
            "properties": {
              "adapter": {
                "properties": {
                  "allowed_commands": {
                    "minItems": 1
                  },
                  "operations": {
                    "required": [
                      "prepare",
                      "status",
                      "self_test"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "properties": {
                  "content": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "adapter": {
                "properties": {
                  "operations": {
                    "required": [
                      "init_article",
                      "approve_outline",
                      "validate_content"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "properties": {
                  "content_review": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "adapter": {
                "properties": {
                  "operations": {
                    "required": [
                      "review_content"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "properties": {
                  "images": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "adapter": {
                "properties": {
                  "operations": {
                    "required": [
                      "image_spec",
                      "optimize_images"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "properties": {
                  "image_source_review": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "adapter": {
                "properties": {
                  "operations": {
                    "required": [
                      "review_image_sources"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "properties": {
                  "image_visual_review": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "adapter": {
                "properties": {
                  "operations": {
                    "required": [
                      "review_images"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "properties": {
                  "wordpress_draft": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "adapter": {
                "properties": {
                  "operations": {
                    "required": [
                      "validate_publish",
                      "preflight",
                      "publish_draft"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "capabilities": {
                "properties": {
                  "verify_only": {
                    "const": true
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "adapter": {
                "properties": {
                  "operations": {
                    "required": [
                      "verify_only"
                    ]
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "site": {
      "type": "object",
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "content": {
      "type": "object",
      "required": [
        "default_language",
        "default_article_type",
        "h1_source",
        "inline_image_counts",
        "minimum_internal_links",
        "external_links"
      ],
      "additionalProperties": true
    },
    "links": {
      "type": "object",
      "required": [
        "allow_relative_internal_links",
        "require_all_declared_targets",
        "required_target_groups"
      ],
      "properties": {
        "allow_relative_internal_links": {
          "type": "boolean"
        },
        "require_all_declared_targets": {
          "type": "boolean"
        },
        "required_target_groups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "product_targets",
                "pillar_targets",
                "related_targets"
              ]
            },
            "uniqueItems": true
          }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "require_external_records",
        "require_external_plan",
        "require_record_for_every_external_link",
        "external_required_fields",
        "require_image_records",
        "image_required_fields"
      ],
      "additionalProperties": true
    },
    "seo": {
      "type": "object",
      "required": [
        "plugin",
        "meta_fields"
      ],
      "properties": {
        "meta_fields": {
          "type": "object",
          "required": [
            "title",
            "description",
            "focus_keyword",
            "canonical"
          ]
        }
      },
      "additionalProperties": true
    },
    "images": {
      "type": "object",
      "required": [
        "featured",
        "inline",
        "style",
        "logo",
        "metadata",
        "spec",
        "plausibility"
      ],
      "properties": {
        "style": {
          "type": "object"
        },
        "infographic": {
          "type": "object",
          "required": [
            "allowed",
            "language"
          ],
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "language": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "spec": {
          "type": "object",
          "required": [
            "required",
            "prompt_target",
            "max_people",
            "default_avoid"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "required_for_source_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "target_model": {
              "type": "string",
              "description": "A key in image-model-registry.json. Set, it supplies prompt_target and max_prompt_words unless this config states them. Empty means the config's own values are used."
            },
            "prompt_target": {
              "type": "string",
              "enum": [
                "negative_prompt",
                "inline_constraints",
                "none",
                "positive_only"
              ],
              "description": "Where exclusions may go. Most current generators have no negative-prompt field, and their vendors say to describe the positive state instead, so none is a normal answer. positive_only is the old name for inline_constraints."
            },
            "max_people": {
              "type": "integer",
              "minimum": 1
            },
            "max_key_objects": {
              "type": "integer",
              "minimum": 1
            },
            "default_avoid": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "plausibility": {
          "type": "object",
          "required": [
            "required",
            "evidence_required",
            "zoom_grid",
            "checks"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "evidence_required": {
              "type": "boolean"
            },
            "min_evidence_chars": {
              "type": "integer",
              "minimum": 0
            },
            "zoom_grid": {
              "type": "integer",
              "minimum": 1
            },
            "crop_scale": {
              "type": "number",
              "minimum": 1
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "question"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "group": {
                    "type": "string"
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1
                  },
                  "not_applicable_when": {
                    "type": "string",
                    "enum": [
                      "always",
                      "no_people",
                      "non_photographic",
                      "no_locale_details",
                      "absent_from_image",
                      "no_spec_reviewer_judgement"
                    ]
                  },
                  "verify_with": {
                    "type": "string",
                    "enum": [
                      "ocr",
                      "count"
                    ],
                    "description": "Route this check to a tool, not to a vision model: OCR for rendered text and an object or digit count for how many. Measured VQA accuracy is 13.7 to 24.9 per cent on rendered text and 67.4 per cent on counting (DSG, arXiv:2310.18235)."
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "wordpress": {
      "type": "object",
      "required": [
        "post_type",
        "default_status"
      ],
      "properties": {
        "default_status": {
          "const": "draft"
        },
        "default_category_name": {
          "type": "string"
        },
        "default_category_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "create_missing_categories": {
          "type": "boolean"
        },
        "external_link_attributes": {
          "type": "object",
          "required": [
            "target_blank",
            "rel"
          ],
          "properties": {
            "target_blank": {
              "type": "boolean"
            },
            "rel": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "env_aliases": {
          "type": "object"
        },
        "state_paths": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "quality_gates": {
      "type": "object",
      "required": [
        "content_review_required",
        "content_review_checklist",
        "image_source_review_required",
        "image_source_review_checklist",
        "image_visual_review_required",
        "publish_validation_required",
        "draft_only"
      ],
      "properties": {
        "content_review_required": {
          "type": "boolean"
        },
        "content_review_checklist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "image_source_review_required": {
          "type": "boolean"
        },
        "image_source_review_checklist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "image_visual_review_required": {
          "type": "boolean"
        },
        "publish_validation_required": {
          "type": "boolean"
        },
        "draft_only": {
          "const": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
